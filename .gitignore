# LaTeX 编译产物
/build/*
!/build/.gitkeep

*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.lof
*.log
*.lot
*.out
*.run.xml
*.synctex.gz
*.toc
*.xdv
*.idx
*.ilg
*.ind
*.ist
*.nlo
*.nls
*.glo
*.gls
*.glg
*.acn
*.acr
*.alg
*.loa

# 根目录中意外生成的论文输出文件
/*.pdf

# 工作日志目录中的临时内容
/logs/*
!/logs/.gitkeep

# 操作系统和编辑器临时文件
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/

# VS Code 的用户级本地配置可以忽略，项目级 settings.json 保留
.vscode/*.code-workspace
